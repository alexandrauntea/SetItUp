rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funcție utilitară pentru a citi datele conversației curente
    function getConversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    // Reguli pentru colecția conversations
    match /conversations/{conversationId} {
      // Permite citirea și actualizarea doar managerilor incluși în managerIds
      allow read, update: if request.auth != null && request.auth.uid in resource.data.managerIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.managerIds;

      // Reguli pentru sub-colecția messages
      match /messages/{messageId} {
        // Permite citirea mesajelor dacă ești manager în acea conversație
        allow read: if request.auth != null && request.auth.uid in getConversationData(conversationId).managerIds;
        
        // Permite crearea unui mesaj DOAR dacă utilizatorul nu este blocat (blockedBy este null)
        allow create: if request.auth != null 
                      && request.auth.uid in getConversationData(conversationId).managerIds
                      && request.auth.uid == request.resource.data.senderId
                      && request.resource.data.senderRole == "manager"
                      && getConversationData(conversationId).blockedBy == null;
      }
    }

    // Reguli pentru colecția blocks
    match /blocks/{blockId} {
      // Oricine este autentificat poate verifica dacă există un block
      allow read: if request.auth != null;
      // Doar managerul autentificat poate crea sau șterge propriul document de block
      allow create: if request.auth != null && request.auth.uid == request.resource.data.blockerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.blockerId;
    }
  }
}