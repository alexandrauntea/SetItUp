rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveManager() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/managerRoles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/managerRoles/$(request.auth.uid)
        ).data.role == 'manager';
    }

    function isActiveManagerFor(ownerId) {
      return isActiveManager()
        && get(
          /databases/$(database)/documents/managerRoles/$(request.auth.uid)
        ).data.counterpartId == ownerId;
    }

    function isMember(data) {
      return isSignedIn()
        && data.memberIds is list
        && request.auth.uid in data.memberIds;
    }

    function isPairId(pairId, uidA, uidB) {
      return pairId == uidA + '_' + uidB
        || pairId == uidB + '_' + uidA;
    }

    function hasValidMembers(data, uidA, uidB) {
      return uidA is string
        && uidB is string
        && uidA != uidB
        && data.memberIds is list
        && data.memberIds.size() == 2
        && uidA in data.memberIds
        && uidB in data.memberIds;
    }

    function friendshipExists(uidA, uidB) {
      return exists(
          /databases/$(database)/documents/friendships/$(uidA + '_' + uidB)
        ) || exists(
          /databases/$(database)/documents/friendships/$(uidB + '_' + uidA)
        );
    }

    function pendingManagerRequestExists(ownerId, managerId) {
      return (
          exists(
            /databases/$(database)/documents/managerRequests/$(ownerId)
          )
          && get(
            /databases/$(database)/documents/managerRequests/$(ownerId)
          ).data.managerId == managerId
          && get(
            /databases/$(database)/documents/managerRequests/$(ownerId)
          ).data.status == 'pending'
        ) || (
          exists(
            /databases/$(database)/documents/managerRequests/$(ownerId + '_' + managerId)
          )
          && get(
            /databases/$(database)/documents/managerRequests/$(ownerId + '_' + managerId)
          ).data.managerId == managerId
          && get(
            /databases/$(database)/documents/managerRequests/$(ownerId + '_' + managerId)
          ).data.status == 'pending'
        );
    }

    function hasValidReactionData(data, reactionId) {
      return data.keys().hasOnly([
          'id',
          'ownerId',
          'targetId',
          'actorId',
          'actorRole',
          'value',
          'createdAt',
          'updatedAt',
          'expiresAt'
        ])
        && data.keys().hasAll([
          'id',
          'ownerId',
          'targetId',
          'actorId',
          'actorRole',
          'value',
          'createdAt',
          'updatedAt'
        ])
        && data.id == reactionId
        && reactionId == data.ownerId + '_' + data.targetId
        && data.ownerId is string
        && data.targetId is string
        && data.ownerId != data.targetId
        && data.actorId == request.auth.uid
        && data.actorRole == 'manager'
        && data.value in ['like', 'dislike']
        && data.createdAt is string
        && data.updatedAt is string
        && (
          (data.value == 'like' && !('expiresAt' in data))
          || (data.value == 'dislike' && data.expiresAt is string)
        )
        && isActiveManagerFor(data.ownerId)
        && exists(
          /databases/$(database)/documents/managerRoles/$(data.targetId)
        )
        && get(
          /databases/$(database)/documents/managerRoles/$(data.targetId)
        ).data.role == 'owner'
        && get(
          /databases/$(database)/documents/managerRoles/$(data.targetId)
        ).data.counterpartId != request.auth.uid;
    }

    function hasValidProfileFields() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'email',
          'birthDate',
          'firstName',
          'lastName',
          'occupation',
          'gender',
          'description',
          'interests',
          'isPrivate',
          'gdprAcceptedAt',
          'profileCompleted',
          'createdAt',
          'updatedAt',
          'photoUrl',
          'photoPaths',
          'primaryPhotoPath'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'username',
          'email',
          'birthDate',
          'firstName',
          'lastName',
          'occupation',
          'gender',
          'description',
          'interests',
          'isPrivate',
          'gdprAcceptedAt',
          'profileCompleted',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.email is string
        && request.resource.data.birthDate is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.occupation is string
        && request.resource.data.gender in ['female', 'male', 'other']
        && request.resource.data.description is string
        && request.resource.data.interests is list
        && request.resource.data.isPrivate is bool
        && request.resource.data.gdprAcceptedAt is string
        && request.resource.data.profileCompleted is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && hasValidPhotoFields(request.resource.data, request.resource.data.uid);
    }

    function hasValidPhotoFields(data, userId) {
      return (!('photoUrl' in data) || data.photoUrl is string)
        && (!('primaryPhotoPath' in data) || data.primaryPhotoPath is string)
        && (!('photoPaths' in data) || (
          data.photoPaths is list
          && data.photoPaths.size() <= 6
          && data.photoPaths.toSet().size() == data.photoPaths.size()
          && (data.photoPaths.size() < 1 || (
            data.photoPaths[0] is string
            && data.photoPaths[0].matches('^profilePhotos/' + userId + '/[^/]+$')
          ))
          && (data.photoPaths.size() < 2 || (
            data.photoPaths[1] is string
            && data.photoPaths[1].matches('^profilePhotos/' + userId + '/[^/]+$')
          ))
          && (data.photoPaths.size() < 3 || (
            data.photoPaths[2] is string
            && data.photoPaths[2].matches('^profilePhotos/' + userId + '/[^/]+$')
          ))
          && (data.photoPaths.size() < 4 || (
            data.photoPaths[3] is string
            && data.photoPaths[3].matches('^profilePhotos/' + userId + '/[^/]+$')
          ))
          && (data.photoPaths.size() < 5 || (
            data.photoPaths[4] is string
            && data.photoPaths[4].matches('^profilePhotos/' + userId + '/[^/]+$')
          ))
          && (data.photoPaths.size() < 6 || (
            data.photoPaths[5] is string
            && data.photoPaths[5].matches('^profilePhotos/' + userId + '/[^/]+$')
          ))
          && (data.photoPaths.size() == 0
            ? (!('primaryPhotoPath' in data) || data.primaryPhotoPath == '')
            : data.primaryPhotoPath in data.photoPaths)
          && (data.photoPaths.size() == 0 || 'photoUrl' in data)
        ));
    }

    function hasValidPublicProfileFields() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'firstName',
          'lastName',
          'occupation',
          'gender',
          'description',
          'interests',
          'age',
          'isPrivate',
          'photoUrl',
          'photoPaths',
          'primaryPhotoPath',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'username',
          'firstName',
          'lastName',
          'occupation',
          'gender',
          'description',
          'interests',
          'age',
          'isPrivate',
          'updatedAt'
        ])
        && request.resource.data.uid is string
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.occupation is string
        && request.resource.data.gender in ['female', 'male', 'other']
        && request.resource.data.description is string
        && request.resource.data.interests is list
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && request.resource.data.isPrivate is bool
        && request.resource.data.updatedAt is string
        && hasValidPhotoFields(request.resource.data, request.resource.data.uid);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && hasValidProfileFields()
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == userId;

      allow update: if isOwner(userId)
        && hasValidProfileFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'occupation',
          'gender',
          'description',
          'interests',
          'isPrivate',
          'photoUrl',
          'photoPaths',
          'primaryPhotoPath',
          'profileCompleted',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId);
    }

    match /usernames/{username} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is string
        && username.matches('^[a-z0-9_]{3,20}$')
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.username == username;

      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      // isPrivate exclude profilul doar din feed; un utilizator autentificat
      // poate deschide profilul din prieteni sau din căutare.
      allow get: if isSignedIn();

      // Feed-ul trebuie să includă filtrul isPrivate == false.
      allow list: if isSignedIn()
        && resource.data.isPrivate == false;

      allow create: if isOwner(userId)
        && hasValidPublicProfileFields()
        && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
        && hasValidPublicProfileFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username;

      allow delete: if isOwner(userId);
    }

    match /friendRequests/{requestId} {
      // O cerere nouă nu există încă. Clientul trebuie să poată verifica
      // documentul exact înainte să îl creeze, fără să poată lista cererile
      // altor utilizatori.
      allow get: if isSignedIn()
        && (!exists(
          /databases/$(database)/documents/friendRequests/$(requestId)
        ) || isMember(resource.data));
      // Interogările inboxului filtrează explicit după senderId sau receiverId.
      // Firestore verifică interogările după rezultatele lor posibile, deci
      // regula trebuie să folosească aceleași câmpuri ca query-urile clientului.
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.receiverId);

      allow create: if isMember(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'id',
          'senderId',
          'senderUsername',
          'receiverId',
          'receiverUsername',
          'memberIds',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'senderId',
          'senderUsername',
          'receiverId',
          'receiverUsername',
          'memberIds',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == requestId
        && isPairId(
          requestId,
          request.resource.data.senderId,
          request.resource.data.receiverId
        )
        && hasValidMembers(
          request.resource.data,
          request.resource.data.senderId,
          request.resource.data.receiverId
        )
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderUsername is string
        && request.resource.data.senderUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.receiverUsername is string
        && request.resource.data.receiverUsername.matches('^[a-z0-9_]{3,20}$')
        && get(
          /databases/$(database)/documents/usernames/$(request.resource.data.senderUsername)
        ).data.uid == request.resource.data.senderId
        && get(
          /databases/$(database)/documents/usernames/$(request.resource.data.receiverUsername)
        ).data.uid == request.resource.data.receiverId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && !friendshipExists(
          request.resource.data.senderId,
          request.resource.data.receiverId
        );

      allow update: if isMember(resource.data)
        && request.auth.uid == resource.data.receiverId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);

      allow delete: if isMember(resource.data);
    }

    match /friendships/{friendshipId} {
      // Aceeași verificare este necesară înainte să existe o prietenie.
      allow get: if isSignedIn()
        && (!exists(
          /databases/$(database)/documents/friendships/$(friendshipId)
        ) || isMember(resource.data) || isActiveManager());
      // Lista de prieteni folosește `memberIds array-contains uid`.
      // Regula trebuie să exprime direct aceeași condiție pentru ca
      // Firestore să poată valida interogarea înainte de a o executa.
      allow list: if isSignedIn()
        && (request.auth.uid in resource.data.memberIds || isActiveManager());
      allow create: if isMember(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'id',
          'memberIds',
          'memberUsernames',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'memberIds',
          'memberUsernames',
          'createdAt'
        ])
        && request.resource.data.id == friendshipId
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string
        && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && isPairId(
          friendshipId,
          request.resource.data.memberIds[0],
          request.resource.data.memberIds[1]
        )
        && request.resource.data.memberUsernames is list
        && request.resource.data.memberUsernames.size() == 2
        && request.resource.data.memberUsernames[0] is string
        && request.resource.data.memberUsernames[1] is string
        && request.resource.data.createdAt is string
        && exists(
          /databases/$(database)/documents/friendRequests/$(friendshipId)
        )
        && get(
          /databases/$(database)/documents/friendRequests/$(friendshipId)
        ).data.receiverId == request.auth.uid
        && (
          (
            request.resource.data.memberIds[0] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.senderId
            && request.resource.data.memberUsernames[0] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.senderUsername
            && request.resource.data.memberIds[1] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.receiverId
            && request.resource.data.memberUsernames[1] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.receiverUsername
          ) || (
            request.resource.data.memberIds[1] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.senderId
            && request.resource.data.memberUsernames[1] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.senderUsername
            && request.resource.data.memberIds[0] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.receiverId
            && request.resource.data.memberUsernames[0] == get(
              /databases/$(database)/documents/friendRequests/$(friendshipId)
            ).data.receiverUsername
          )
        )
        && !existsAfter(
          /databases/$(database)/documents/friendRequests/$(friendshipId)
        );
      allow update: if false;
      allow delete: if isMember(resource.data);
    }

    match /managerRequests/{requestId} {
      // Documentul exact este verificat înainte de creare. Dacă încă nu
      // există, nu conține date care ar putea fi expuse.
      allow get: if isSignedIn()
        && (!exists(
          /databases/$(database)/documents/managerRequests/$(requestId)
        ) || isMember(resource.data));
      // Ecranul filtrează explicit după ownerId sau managerId. Interogările
      // folosite la ștergerea unei prietenii filtrează după memberIds.
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.ownerId
          || request.auth.uid == resource.data.managerId
          || request.auth.uid in resource.data.memberIds);

      allow create: if isMember(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'id',
          'ownerId',
          'ownerUsername',
          'managerId',
          'managerUsername',
          'memberIds',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'ownerId',
          'ownerUsername',
          'managerId',
          'managerUsername',
          'memberIds',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == requestId
        // UID-ul ownerului este cheia unică: un profil poate avea cel mult o
        // singură propunere de manager activă, indiferent de managerul ales.
        && requestId == request.resource.data.ownerId
        && hasValidMembers(
          request.resource.data,
          request.resource.data.ownerId,
          request.resource.data.managerId
        )
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerUsername is string
        && request.resource.data.ownerUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.managerUsername is string
        && request.resource.data.managerUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && friendshipExists(
          request.resource.data.ownerId,
          request.resource.data.managerId
        )
        && !exists(
          /databases/$(database)/documents/managerRelationships/$(request.resource.data.ownerId)
        )
        && !exists(
          /databases/$(database)/documents/managerRoles/$(request.resource.data.ownerId)
        )
        && !exists(
          /databases/$(database)/documents/managerRoles/$(request.resource.data.managerId)
        );

      allow update: if isMember(resource.data)
        && request.auth.uid == resource.data.managerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);

      allow delete: if isMember(resource.data);
    }

    match /managerRelationships/{relationshipId} {
      // Acceptarea unei propuneri verifică mai întâi că relația nu există.
      allow get: if isSignedIn()
        && (!exists(
          /databases/$(database)/documents/managerRelationships/$(relationshipId)
        ) || isMember(resource.data));
      allow list: if isSignedIn()
        && (request.auth.uid == resource.data.ownerId
          || request.auth.uid == resource.data.managerId
          || request.auth.uid in resource.data.memberIds);
      allow create: if isMember(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'ownerUsername',
          'managerId',
          'managerUsername',
          'memberIds',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId',
          'ownerUsername',
          'managerId',
          'managerUsername',
          'memberIds',
          'createdAt'
        ])
        && relationshipId == request.resource.data.ownerId
        && request.resource.data.managerId == request.auth.uid
        && hasValidMembers(
          request.resource.data,
          request.resource.data.ownerId,
          request.resource.data.managerId
        )
        && request.resource.data.ownerUsername is string
        && request.resource.data.ownerUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.managerUsername is string
        && request.resource.data.managerUsername.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.createdAt is string
        && getAfter(
          /databases/$(database)/documents/managerRoles/$(request.resource.data.ownerId)
        ).data.role == 'owner'
        && getAfter(
          /databases/$(database)/documents/managerRoles/$(request.resource.data.ownerId)
        ).data.counterpartId == request.resource.data.managerId
        && getAfter(
          /databases/$(database)/documents/managerRoles/$(request.resource.data.managerId)
        ).data.role == 'manager'
        && getAfter(
          /databases/$(database)/documents/managerRoles/$(request.resource.data.managerId)
        ).data.counterpartId == request.resource.data.ownerId
        && friendshipExists(
          request.resource.data.ownerId,
          request.resource.data.managerId
        )
        && (
          (
            exists(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId)
            )
            && get(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId)
            ).data.ownerUsername == request.resource.data.ownerUsername
            && get(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId)
            ).data.managerUsername == request.resource.data.managerUsername
            && !existsAfter(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId)
            )
          )
          // Compatibilitate temporară cu propunerile create înainte ca ID-ul
          // să devină unic per owner.
          || (
            exists(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId + '_' + request.resource.data.managerId)
            )
            && get(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId + '_' + request.resource.data.managerId)
            ).data.ownerUsername == request.resource.data.ownerUsername
            && get(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId + '_' + request.resource.data.managerId)
            ).data.managerUsername == request.resource.data.managerUsername
            && !existsAfter(
              /databases/$(database)/documents/managerRequests/$(request.resource.data.ownerId + '_' + request.resource.data.managerId)
            )
          )
        );
      allow update: if false;
      allow delete: if isMember(resource.data)
        && !existsAfter(
          /databases/$(database)/documents/managerRoles/$(resource.data.ownerId)
        )
        && !existsAfter(
          /databases/$(database)/documents/managerRoles/$(resource.data.managerId)
        );
    }

    match /reactions/{reactionId} {
      allow get: if isActiveManager()
        && (!exists(
          /databases/$(database)/documents/reactions/$(reactionId)
        )
          || isActiveManagerFor(resource.data.ownerId)
          || isActiveManagerFor(resource.data.targetId));
      allow list: if isActiveManagerFor(resource.data.ownerId);

      allow create: if hasValidReactionData(request.resource.data, reactionId);
      allow update: if hasValidReactionData(request.resource.data, reactionId)
        && resource.data.ownerId == request.resource.data.ownerId
        && resource.data.targetId == request.resource.data.targetId
        && resource.data.value == 'dislike';
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isActiveManager()
        && (!exists(
          /databases/$(database)/documents/matches/$(matchId)
        ) || get(
          /databases/$(database)/documents/managerRoles/$(request.auth.uid)
        ).data.counterpartId in resource.data.memberIds);
      allow list: if isActiveManager()
        && get(
          /databases/$(database)/documents/managerRoles/$(request.auth.uid)
        ).data.counterpartId in resource.data.memberIds;
      allow create: if isActiveManager()
        && request.resource.data.keys().hasOnly([
          'id',
          'memberIds',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'memberIds',
          'createdAt'
        ])
        && request.resource.data.id == matchId
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string
        && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && isPairId(
          matchId,
          request.resource.data.memberIds[0],
          request.resource.data.memberIds[1]
        )
        && request.resource.data.createdAt is string
        && get(
          /databases/$(database)/documents/managerRoles/$(request.auth.uid)
        ).data.counterpartId in request.resource.data.memberIds
        && getAfter(
          /databases/$(database)/documents/reactions/$(request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1])
        ).data.value == 'like'
        && getAfter(
          /databases/$(database)/documents/reactions/$(request.resource.data.memberIds[1] + '_' + request.resource.data.memberIds[0])
        ).data.value == 'like';
      allow update, delete: if false;
    }

    // A conversation belongs to the two managers assigned to the matched
    // profiles. Queries must filter managerIds with array-contains.
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.managerIds;

      allow create: if isSignedIn()
        && request.resource.data.managerIds is list
        && request.resource.data.managerIds.size() == 2
        && request.auth.uid in request.resource.data.managerIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.matchId == conversationId
        && request.resource.data.blockedBy == null;

      allow update: if isSignedIn()
        && resource.data.managerIds is list
        && request.auth.uid in resource.data.managerIds
        && request.resource.data.managerIds == resource.data.managerIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.matchId == resource.data.matchId;

      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
        }

        allow read: if isSignedIn()
          && request.auth.uid in conversation().managerIds;

        allow create: if isSignedIn()
          && request.auth.uid in conversation().managerIds
          && conversation().blockedBy == null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == 'manager'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.blockerId
          || request.auth.uid == resource.data.blockedId);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.blockerId;
      allow update: if false;
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.blockerId;
    }

    match /managerRoles/{uid} {
      allow get: if isSignedIn()
        && (request.auth.uid == uid
          || isActiveManager()
          // Managerul invitat trebuie să poată verifica dacă ownerul are deja
          // un rol înainte de scrierile atomice din tranzacția de acceptare.
          || pendingManagerRequestExists(uid, request.auth.uid));
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'role',
          'counterpartId',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'role',
          'counterpartId',
          'createdAt'
        ])
        && uid == request.resource.data.uid
        && request.resource.data.createdAt is string
        && (
          (
            request.resource.data.role == 'owner'
            && request.auth.uid == request.resource.data.counterpartId
            && getAfter(
              /databases/$(database)/documents/managerRelationships/$(uid)
            ).data.ownerId == uid
            && getAfter(
              /databases/$(database)/documents/managerRelationships/$(uid)
            ).data.managerId == request.resource.data.counterpartId
          )
          || (
            request.resource.data.role == 'manager'
            && request.auth.uid == uid
            && getAfter(
              /databases/$(database)/documents/managerRelationships/$(request.resource.data.counterpartId)
            ).data.ownerId == request.resource.data.counterpartId
            && getAfter(
              /databases/$(database)/documents/managerRelationships/$(request.resource.data.counterpartId)
            ).data.managerId == uid
          )
        );

      allow update: if false;

      allow delete: if isSignedIn()
        && (request.auth.uid == uid
          || request.auth.uid == resource.data.counterpartId)
        && (
          (resource.data.role == 'owner' && !existsAfter(
            /databases/$(database)/documents/managerRelationships/$(uid)
          ))
          || (resource.data.role == 'manager' && !existsAfter(
            /databases/$(database)/documents/managerRelationships/$(resource.data.counterpartId)
          ))
        );
    }
  }
}
